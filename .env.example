# Conexão com o Supabase (Lovable Cloud). Só chaves públicas — nada de secret aqui.
SUPABASE_PROJECT_ID="seu-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_URL="https://seu-project-id.supabase.co"
VITE_SUPABASE_PROJECT_ID="seu-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_URL="https://seu-project-id.supabase.co"

# Segredos de servidor (NÃO colocar neste arquivo nem no .env versionado).
# Configure no painel do Lovable / Supabase:
#   LOVABLE_API_KEY           -> envio de e-mail gerenciado (Resend)
#   LOVABLE_CRON_SECRET       -> autenticação do cron da rotina diária (Fase 2)
#   LOVABLE_CRON_SECRET_PREVIOUS
